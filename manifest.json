{
  "manifest_version": 3,
  "name": "LeetHub 5.0",
  "description": "Automatically integrate your Leetcode submissions to GitHub",
  "homepage_url": "https://github.com/14-Tanmay/LeetHubV5",
  "version": "0.0.16",
  "author": "Tanmay Paul",
  "action": {
    "default_icon": "assets/thumbnail.png",
    "default_popup": "src/html/popup.html"
  },
  "icons": {
    "16": "assets/thumbnail.png",
    "48": "assets/thumbnail.png",
    "128": "assets/thumbnail.png"
  },
  "background": {
    "service_worker": "src/js/background.js"
  },
  "permissions": ["unlimitedStorage", "storage"],
  "host_permissions": ["https://leetcode.com/*", "https://leetcode.cn/*"],
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/*", "https://leetcode.cn/*", "https://github.com/*", "https://practice.geeksforgeeks.org/*", "https://www.geeksforgeeks.org/*", "https://www.codechef.com/*"],
      "js": ["src/js/interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://leetcode.com/*", "https://leetcode.cn/*", "https://github.com/*"],
      "js": ["src/js/github.js", "src/js/leetcode.js", "src/js/authorize.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://practice.geeksforgeeks.org/*", "https://www.geeksforgeeks.org/*"],
      "js": ["src/js/github.js", "src/js/gfg.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.codechef.com/*"],
      "js": ["src/js/github.js", "src/js/codechef.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": ["src/js/interceptor.js"],
      "matches": ["https://leetcode.com/*", "https://leetcode.cn/*", "https://practice.geeksforgeeks.org/*", "https://www.geeksforgeeks.org/*", "https://www.codechef.com/*"]
    }
  ]
}
